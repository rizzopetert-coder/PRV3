ANTHROPIC_API_KEY=your-key-here
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token
# Shared secret for internal Next.js -> Python engine calls
# Must match ENGINE_SECRET in Vercel environment variables
ENGINE_SECRET=your-secret-here
# Real Transaction Path, Phase 1 (e-signature only) -- Dropbox Sign.
# DROPBOX_SIGN_API_KEY authenticates outbound calls to
# /signature_request/send_with_template. DROPBOX_SIGN_TEMPLATE_ID is the
# one-time Dropbox Sign dashboard Template built from
# documents/PRV3_Engagement_Agreement_Draft_v1.0.docx (signer role "Client").
# No webhook secret needed yet -- /api/engage/webhook is deferred to Phase 2.
DROPBOX_SIGN_API_KEY=your-dropbox-sign-api-key
DROPBOX_SIGN_TEMPLATE_ID=your-dropbox-sign-template-id
