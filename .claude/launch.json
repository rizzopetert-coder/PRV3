{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prv3-web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "prv3-web-start",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "start", "--", "-p", "3100"],
      "env": { "ENGINE_BASE_URL": "http://127.0.0.1:8000" },
      "port": 3100
    }
  ]
}
