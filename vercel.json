{
  "builds": [
    {
      "src": "web/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/engine.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/engine",
      "dest": "/api/engine.py"
    },
    {
      "src": "/api/accumulate",
      "dest": "/api/engine.py"
    },
    {
      "src": "/api/checkpoint",
      "dest": "/api/engine.py"
    },
    {
      "src": "/api/complete",
      "dest": "/api/engine.py"
    },
    {
      "src": "/api/question-copy",
      "dest": "/api/engine.py"
    },
    {
      "src": "/api/condensed-complete",
      "dest": "/api/engine.py"
    },
    {
      "src": "/(.*)",
      "dest": "/web/$1"
    }
  ]
}
